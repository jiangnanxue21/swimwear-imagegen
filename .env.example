# ==========================================================
# 网站商品展示图自动生成系统 - 环境变量样例
# 复制为 .env 后使用:cp .env.example .env
# 未填写任何第三方 Key 时,系统以 Mock 模式正常启动。
# ==========================================================

# --- 应用 ---
APP_NAME=swimwear-imagegen
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api
# 逗号分隔的完整来源。后端开着 allow_credentials,所以**不要填 `*`**:
# 浏览器会直接拒绝这种组合,等于线上前端全线报跨域,而且本地怎么试都试不出来
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=imagegen
POSTGRES_PASSWORD=imagegen
POSTGRES_DB=imagegen
# 留空则由上面各项自动拼接;本机直连时改为 localhost
DATABASE_URL=

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false

# --- 存储 ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000
# 阶段 6 对象存储扩展位,当前留空
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# CDN 或自定义域名,留空则用 endpoint/bucket 拼
S3_PUBLIC_BASE_URL=

# --- 上传限制 ---
MAX_UPLOAD_SIZE_MB=20
MIN_IMAGE_EDGE_PX=256
# 允许从内网下载结果图的主机(逗号分隔)。自建 ComfyUI 时填它的主机名,例如 comfyui
# 云元数据端点 169.254.169.254 即使填进来也一律拒绝
DOWNLOAD_ALLOWED_HOSTS=

# --- Provider(阶段 3 起生效;留空则该 Provider 显示"未配置") ---
DEFAULT_PROVIDER=mock
PROVIDER_ROUTING_MODE=MANUAL
# 一个任务累计允许跑多少轮(含人工审核里追加的)。人工可反复要求重生,但不能无限加
MAX_TOTAL_ROUNDS=10

# FASHN(https://app.fashn.ai/api 取 Key)。只填 Key 即可;其余留空走官方默认值。
FASHN_API_KEY=
# 留空 = https://api.fashn.ai/v1
FASHN_BASE_URL=
# tryon-max(旗舰,可发布质量)| tryon-v1.6(快且便宜,输出 864x1296)
FASHN_TRYON_MODEL=tryon-max
# tryon-max: balanced|quality;product-to-model: fast|balanced|quality;留空由 FASHN 自选
FASHN_GENERATION_MODE=
# 1k|2k|4k,留空用 FASHN 默认(1k)。分辨率越高消耗额度越多
FASHN_RESOLUTION=
FASHN_OUTPUT_FORMAT=png
FASHN_REQUEST_TIMEOUT_SECONDS=60
FASHN_POLL_INTERVAL_SECONDS=2
# 一次生成 20-120 秒,官方 SDK 的默认上限也是 300 秒
FASHN_POLL_TIMEOUT_SECONDS=300
FASHN_MAX_IMAGE_MB=10
# 存储换成公网可达的对象存储后设为 true,可省掉 base64 内联
FASHN_SEND_PUBLIC_URLS=false
FAL_API_KEY=
FAL_BASE_URL=
COMFYUI_BASE_URL=
COMFYUI_CONFIG_FILE=./comfyui/config.yaml

# --- 评分(阶段 4 起生效) ---
# mock | vision。mock 是离线演练模式,按文件指纹给分,**不能用来决定上不上网站**
EVALUATOR_BACKEND=mock

# --- 视觉评分模型 ---
# 三家的完整示例见 docs/VISION-EVALUATOR.md。填之前先想清楚一件事:
# 模型只负责逐维度打分,总分、A/B/C/D 分档、自动通过与否全部由后端算 ——
# 换模型会改变分数分布,因此换完必须用人工审核样本重新校准阈值。
VISION_MODEL_API_KEY=
VISION_MODEL_BASE_URL=
# 模型名。方舟若使用推理接入点,这里填 Endpoint ID
VISION_MODEL_NAME=

# responses | chat_completions
# 按 API 形状选,不按厂商选。OpenAI 与方舟走 responses,百炼兼容模式走 chat_completions
VISION_MODEL_API_STYLE=responses

# json_schema | json_object | prompt_only
# 端点报"不支持 response_format"时逐级往下降
VISION_MODEL_RESPONSE_FORMAT=json_schema

VISION_MODEL_TIMEOUT_SECONDS=90
# 单张图上限(MB)。超了直接拒绝,不会悄悄压缩后发出去
VISION_MODEL_MAX_IMAGE_MB=8
# 最多发几张参考图。多发一张就多一份 token 成本,顺序即重要性,超出部分截断
VISION_MODEL_MAX_REFERENCE_IMAGES=4
VISION_MODEL_MAX_OUTPUT_TOKENS=1800
VISION_MODEL_MAX_RETRIES=2
VISION_MODEL_RETRY_BASE_SECONDS=0.5

# low | high | original | auto。FULL 看细节,QUICK 只看大面
# original 只有部分端点支持,报错就换 high
VISION_MODEL_FULL_IMAGE_DETAIL=high
VISION_MODEL_QUICK_IMAGE_DETAIL=low

# none | low | medium | high
# 千问 VL 用 none:思考内容混进输出会破坏标准 JSON
VISION_MODEL_REASONING_EFFORT=low

# true 时尽量用 storage.public_url();false 时读出来转 data URL。
# 存储换成公网可达的对象存储之后再打开 —— 厂商访问不到 localhost 地址
VISION_MODEL_SEND_PUBLIC_URLS=false

# 评分器用不了时的行为。true = 抛错转人工,false = 允许退回 Mock。
# **production 环境必须为 true**:退回 Mock 意味着没被真正评过的图自动发上网站
VISION_MODEL_FAIL_CLOSED=true
# 显式声明端点无鉴权。自建但挂了公网域名时打开;默认按主机名判断
VISION_MODEL_ALLOW_ANONYMOUS=false

# --- 属性识别 · 多模态(阶段 3 起生效) ---
# mock | vision。mock 按图片指纹**编造**属性,只用于离线演练 ——
# 它写出来的颜色/图案会进文案宣称和上架草稿,末端是一份看起来合规的假 Listing。
# 选 vision 但没配好时,第一次识别直接报错并点名缺哪个键,不会静默退回 mock
EXTRACTOR_BACKEND=mock

# 这一组**独立于 VISION_MODEL_***,即便填同一个端点也要各填一遍。
# 不做静默共享的理由:识别的置信度校准按(字段 × 模型 × 提示词)分箱存,
# 共享配置意味着换一次评分模型就把识别的全部校准数据作废,而且没有任何提示
EXTRACTOR_MODEL_API_KEY=
EXTRACTOR_MODEL_BASE_URL=
# 模型名。方舟若使用推理接入点,这里填 Endpoint ID
EXTRACTOR_MODEL_NAME=

# responses | chat_completions。按 API 形状选,不按厂商选
EXTRACTOR_MODEL_API_STYLE=responses
# json_schema | json_object | prompt_only。端点报"不支持"时逐级往下降
EXTRACTOR_MODEL_RESPONSE_FORMAT=json_schema

# 一次识别最多发几张图。识别目前是同步逐图调用,一次点击 = 这么多次付费调用;
# 超出时接口直接拒绝并提示分批,不会先跑一半再超时。mock 不受此限
EXTRACTOR_MAX_IMAGES_PER_RUN=12

EXTRACTOR_MODEL_TIMEOUT_SECONDS=60
# 单张图上限(MB)。超了直接拒绝,不会悄悄压缩后发出去
EXTRACTOR_MODEL_MAX_IMAGE_MB=8
EXTRACTOR_MODEL_MAX_OUTPUT_TOKENS=1500
EXTRACTOR_MODEL_MAX_RETRIES=2
EXTRACTOR_MODEL_RETRY_BASE_SECONDS=0.5
# high | low | auto。识别只有这一档:产出会变成商品事实,没有"粗看一眼"这个档位
EXTRACTOR_MODEL_IMAGE_DETAIL=high
# none | low | medium | high。千问 VL 用 none:思考内容混进输出会破坏标准 JSON
EXTRACTOR_MODEL_REASONING_EFFORT=low
# true 时尽量用 storage.public_url();false 时读出来转 data URL
EXTRACTOR_MODEL_SEND_PUBLIC_URLS=false
# 显式声明端点无鉴权。默认按主机名判断,判断不出来时**要求填 Key** ——
# 反过来会把"忘了配 Key"伪装成"已配置",然后每次调用都 401
EXTRACTOR_MODEL_ALLOW_ANONYMOUS=false

# --- 批量执行 ---
# 批次在哪里跑:
#   inline = 在 HTTP 请求内执行,但每件一个独立事务(默认,适合本地模板/毫秒级动作)
#   celery = 接口只建批次并立刻返回 batch_id,由 worker 领取,前端轮询状态
# 接上真实模型后必须切到 celery:50 次远程调用挤在一个请求里,网关会先断,
# 而那时钱已经花了。写错的值在启动期报错,不会静默退回 inline。
BATCH_EXECUTION_MODE=inline

# --- 文案生成 ---
# 用哪个文案生成器:template = 本地模板,不调模型不产生费用;
# llm = 调用下面的 TEXT_MODEL_*,产生费用。
# 只认这两个值,写错在启动期就报错(不会静默退回 template)。
COPY_GENERATOR=template

# --- 文本模型(非多模态) ---
# COPY_GENERATOR=llm 时才会被读到。填了但生成器仍是 template 的话不会有效果,
# 反过来选了 llm 却没填完整,文案生成会直接报错转人工,而不是悄悄退回模板
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=
TEXT_MODEL_NAME=
# responses / chat_completions。决定往哪个端点发请求,选错的表现是 404
TEXT_MODEL_API_STYLE=chat_completions

# --- 后台设置页(阶段 8) ---
# 这一段决定「谁能在网页上改配置」以及「改出来的密钥怎么存」。
#
# 后台写入的密钥在落库前用这把主密钥加密。留空则自动在下面的密钥目录生成 .settings.key,
# 单机 docker compose 开箱可用;多机部署必须显式配置,否则各节点解不开对方写的值。
# 生成一把:openssl rand -base64 32
SETTINGS_SECRET_KEY=
# 自动生成的主密钥放哪。留空 = 项目根下的 .secrets/。
# **绝不能指向 STORAGE_LOCAL_DIR 或它的子目录** —— 那个目录会被挂成 /files 静态服务,
# 主密钥放进去等于连同数据库一起公开。docker compose 里已指向独立的 secrets 卷。
SETTINGS_KEY_DIR=
# 打开后:凡是本文件已经给了值的配置项,网页上一律只读,数据库覆盖不生效。
# 生产环境建议 true —— 配置由部署流水线说了算,网页只用来看
SETTINGS_ENV_LOCK=false
# 覆盖值的进程内缓存时长(秒)。改完配置最迟这么久 worker 也会跟上,不需要重启
SETTINGS_CACHE_TTL_SECONDS=10
# 设置页(读 + 写)与 Provider 连接测试的口令,请求头 X-Admin-Token。
# 留空时:APP_ENV 是 local/dev/development 才放行,其余环境一律拒绝。
# 注意 test 不在放行名单里 —— 测试环境通常是一台连着真 Key 的真机器
ADMIN_TOKEN=
# 日常业务写接口(商品、素材、生成任务、人工审核)的口令,请求头 X-Operator-Token。
# 管理口令天然包含这一级,不必重复配置。
# 一人一个口令时写成 alice:xxx,bob:yyy —— 审计日志里记的就是 alice/bob 这个已验证的名字,
# 而不是请求头里任人填写的 X-Actor。只写一个裸口令时所有人共用 operator 这个名字。
# 留空且 ADMIN_TOKEN 也留空时:local/dev/development 放行,其余环境拒绝一切写操作
# 口令里不能含逗号和分号(它们是多条目分隔符);名字里不能含冒号。
# 随手生成时用 openssl rand -hex 16 之类的十六进制串最省心
# 共用口令请**避开冒号**:`名字:口令` 是这一项的分隔写法,而共用口令里的
# 冒号会被当成分隔符。前半截长得不像名字(含 @ 等符号)时会按共用口令处理,
# 但 `abc:def` 这种两可的写法一律按 `名字:口令` 读 —— 拿不准就用 `名字:口令`。
OPERATOR_TOKENS=

# ---------------------------------------------------------------- 费用与预算(A23)
#
# 记的是本系统发起的付费调用,不是厂商账户余额 —— 两者会不一致(共用 Key、
# 赠送额度、失败但已计费的调用)。权威数字在厂商控制台,这里是本地台账。
#
# 价目表 JSON。micros = 微单位,1 货币单位 = 1_000_000 微。
# 例:FASHN 每次调用 0.04 USD -> 40000
# 留空则所有调用记 0 元,看板会提示"未配价"而不是画一条假的绿线。
PROVIDER_PRICE_BOOK=
PRICING_VERSION=v1

# 月度预算(微单位)。0 = 未设。例:200 USD -> 200000000
SPEND_MONTHLY_BUDGET_MICROS=0
SPEND_CURRENCY=USD
SPEND_WARN_RATIO=0.7
SPEND_CRITICAL_RATIO=0.9
