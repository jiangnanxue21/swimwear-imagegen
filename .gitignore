# 凭据 —— 硬规则 1 的第一道拦截(verify_delivery.py 逐类核对这一份)。
# 主密钥连着两个交付包出去过;.gitignore 缺席正是那次事故的起点。
.secrets/
.env
.env.local
*.key
*.pem
comfyui/config.yaml

# 运行期数据(真实素材与产出,会被挂成 /files 对外托管)
storage/

# 依赖与构建产物
node_modules/
.venv/
venv/
dist/
# Vite/Vitest 缓存。默认在 node_modules/.vite 之下(被上面那行连带忽略),
# vitest.config.ts 把它搬了出来(理由在那边:root 装的依赖会让默认位置
# 对跑测试的用户变成只读),搬出来之后就要在这里单独记一行
.vite-cache/
.import_linter_cache/
.tmp*/
*.egg-info/
test-results/
playwright-report/
*.tsbuildinfo
coverage/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# 运行期日志。uvicorn 的 stdout/stderr 落盘后含完整请求行、异常栈、图片绝对
# 路径与上游 URL 查询串;这两个具名文件已随交付包出去过两次,所以除了通配
# 之外再逐个点名,避免以后有人把通配那行当噪音删掉。
*.log
backend/.api-stdout.log
backend/.api-stderr.log

# 编辑器与系统
.DS_Store
.idea/
.vscode/
# Claude Code 个人权限配置(含开发机绝对路径)。随包出去过一次 —— 见 DECISIONS。
# 共享设置走 .claude/settings.json,个人设置恒为 settings.local.json。
.claude/settings.local.json
